---
layout: layouts/home.njk
title: Home
intro:
  eyebrow: Cats, DevOps, and Art
  main: Exposition
  buttonText: Dive In
  buttonURL: '/work'
  image: /images/polite_cat.webp
  imageAlt: 'Olie the polite cat'

primaryCTA:
  title: 'Cats, DevOps and Art'
  summary: 'My first attempt at coding my own personal site. Following learn-eleventy.pages.dev'
  buttonText: 'A link to course'
  buttonUrl: 'https://learneleventyfromscratch.com'

---

<article class="intro">
	<div class="[ intro__header ] [ radius frame ]">
		<h1 class="[ intro__heading ] [ weight-normal text-400 md:text-600 ]">
			{{ intro.eyebrow }}
			<em class="text-800 md:text-900 lg:text-major weight-bold">{{ intro.main }}</em>
		</h1>
	</div>
	<div class="[ intro__content ] [ flow ]">
		<p class="intro__summary">{{ intro.summary }}</p>
		<a href="{{ intro.buttonUrl }}" class="button">{{ intro.buttonText }}</a>
	</div>
	<div class="[ intro__media ] [ radius dot-shadow ]">
		<img
			class="[ intro__image ] [ radius ]"
			src="{{ intro.image }}"
			alt="{{ intro.imageAlt }}"
		/>
	</div>
</article>